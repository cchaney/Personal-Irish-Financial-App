# OPTIONAL. PIFA works without this file.
# To change a setting: copy this file to .env, edit it, then run: docker compose up -d
# Never commit your .env file.

# Port PIFA is served on: http://localhost:8080
PIFA_PORT=8080

# true = block ALL internet access from PIFA (no price updates, no cloud AI).
PIFA_OFFLINE=false

# Default AI provider on first run: none | ollama | openai | anthropic
# (You can change it any time in Settings -> AI coach.)
PIFA_AI_PROVIDER=none

# Local AI with Ollama (start with: docker compose --profile ai up -d)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Any OpenAI-compatible local server, e.g. LM Studio on your computer
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_MODEL=

# Optional: Claude via the Anthropic API (sends a summary of your finances to the cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
